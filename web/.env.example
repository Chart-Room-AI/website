# Chart Room AI — public site overrides (optional)
# NEXT_PUBLIC_CONTACT_EMAIL=info@chartroomai.com
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/marc-cheatham-83b35b22/
# NEXT_PUBLIC_BOOKING_URL=
# NEXT_PUBLIC_AUDIT_URL=
# NEXT_PUBLIC_RESUME_URL=/documents/Marc-Cheatham-Resume.pdf
# NEXT_PUBLIC_FORM_ENDPOINT=/api/contact

# Contact form delivery
# Local/dev default is no-send unless CONTACT_DELIVERY_MODE is set.
# CONTACT_DELIVERY_MODE=noop
# CONTACT_DELIVERY_MODE=microsoft_graph
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# CONTACT_FROM_MAILBOX=info@chartroomai.com
# CONTACT_TO_EMAIL=info@chartroomai.com
# Display name on outbound form mail. Note: Exchange Online replaces this with the
# CONTACT_FROM_MAILBOX user's directory display name (set in the M365 admin center),
# so the name recipients see is controlled there, not here.
# CONTACT_FROM_NAME=Marc Cheatham

# Cloudflare Turnstile (bot protection)
# Public site key — safe to expose to the browser (Vercel: Production + Preview).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secret — never use NEXT_PUBLIC_ prefix (Vercel: Production + Preview).
# TURNSTILE_SECRET_KEY=
# Optional CSV of extra allowed hostnames from siteverify (defaults include
# chartroomai.com, www.chartroomai.com, carehelm.chartroomai.com, and *.vercel.app).
# TURNSTILE_ALLOWED_HOSTNAMES=
